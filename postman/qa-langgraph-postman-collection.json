{
  "info": {
    "name": "qa-langgraph",
    "_postman_id": "a1c2d3e4-qa-langgraph-0000-0000-000000000000",
    "description": "Postman collection for the qa-langgraph Flask app. Contains a single request: POST /run (multipart/form-data: query, file).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Run Agent",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "query",
              "value": "How do I reverse a list in Python?",
              "type": "text",
              "description": "The question/instruction for the agent (required)."
            },
            {
              "key": "file",
              "type": "file",
              "src": "",
              "description": "Upload a plain-text file containing the agent system prompt/definition (required). In Postman, click the file field and choose a local file."
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/run",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "run"
          ]
        },
        "description": "POST /run — Expects multipart/form-data with text field 'query' and file field 'file'. Returns JSON with either {\"result\": \"...\"} or {\"error\": \"...\"}."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200 or 400 or 500\", function () {",
              "    pm.expect([200,400,500]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test(\"Response has result or error key\", function () {",
              "    var json = {};",
              "    try { json = pm.response.json(); } catch (e) { pm.expect.fail('Response is not valid JSON'); }",
              "    pm.expect(json).to.have.any.keys('result', 'error');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Run Agent - missing file (example)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "query",
              "value": "Will this return an error without a file?",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/run",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "run"
          ]
        },
        "description": "Example request to show the server returns a 400 when file is missing."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 400 when file missing\", function () {",
              "    pm.expect(pm.response.code).to.eql(400);",
              "});",
              "",
              "pm.test(\"Response has error key\", function () {",
              "    var json = {};",
              "    try { json = pm.response.json(); } catch (e) { pm.expect.fail('Response is not valid JSON'); }",
              "    pm.expect(json).to.have.property('error');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}

